# Copy to /etc/nginx/snippets/tarmar-proxy-secret.conf on the server
# (create the snippets/ directory if it doesn't exist yet). Keep it
# root-owned and out of git -- it is the one thing on this box that proves
# a request actually came through nginx rather than from another
# co-hosted process (melee, orge) connecting to gunicorn over loopback
# (issue #161 part 3).
#
# Generate a value with, e.g.: openssl rand -hex 32
# Then set the identical value as PROXY_SHARED_SECRET in tarmar's .env.
#
# tarmar/tarmar.conf includes this file with a glob, so it is fine to
# leave it absent -- the app falls back to its peer-IP-only check exactly
# as it did before this file existed.

set $tarmar_proxy_secret "replace-with-a-long-random-value";
