{
  "name": "tarmar-studio",
  "version": "1.0.0",
  "private": true,
  "description": "JavaScript tests for Tarmar Studio",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "rimraf .nyc_output && playwright test && nyc report --reporter=text --reporter=text-summary",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "coverage:e2e": "nyc report --reporter=html && open coverage/index.html"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.2",
    "v8-to-istanbul": "^9.3.0"
  },
  "nyc": {
    "include": [
      "static/js/**/*.js",
      "accounts/static/accounts/js/**/*.js"
    ],
    "exclude": [
      "**/__tests__/**",
      "**/*.test.js"
    ],
    "all": true
  },
  "jsCoverageThreshold": 81,
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  }
}
