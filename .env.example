# Tarmar Studio — environment variables
# Copy to .env and fill in. .env is gitignored.

# Django
SECRET_KEY=replace-me-with-a-long-random-string
# True for local development. Production must set DEBUG=False via real
# environment variables, not by copying this file.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (omit for SQLite; set for PostgreSQL in prod)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Passphrase gate. settings.py reads GATE_PASSPHRASE; the dev default is
# "mellon" when this is unset. Leave it commented out to use that default --
# load_dotenv sets an uncommented empty value to "", which overrides the
# fallback and disables the gate (issue #149). Set a private value in
# production.
# GATE_PASSPHRASE=your-phrase-here

# The hints the gate shows after repeated wrong guesses (issues #55, #77): a
# text file, one hint per line, blank lines and # lines ignored, read once at
# startup (a missing or empty file refuses to start). Defaults to
# config/gate-hints.txt in the checkout; set this to use another file. A
# relative path is taken from the checkout root, whatever directory the server
# was started from; an absolute path is used as given. An uncommented empty
# value means the default.
# GATE_HINTS_FILE=config/gate-hints.txt

# The words a Game Master's rulings on a battle are shown in (issues #867,
# #37): panel headings and buttons, battle-log lines and refusals, a TOML file
# read and checked once at startup (a missing key, an unknown key or a stray
# {name} refuses to start). Defaults to config/battle-rulings.toml; a relative
# path is taken from the checkout root. An uncommented empty value means the
# default.
# BATTLE_RULINGS_WORDING_FILE=config/battle-rulings.toml

# How many wrong guesses from one address before a hint is shown. Default 3
# (the #55 evidence, in common/gate.py). Must stay below the gate limiter's
# budget, common.rate_limit.GUESS_MAX_ATTEMPTS, or the hint only ever appears
# on the lockout page. An uncommented empty value means the default.
# GATE_HINT_AFTER_WRONG_GUESSES=3

# Trust the reverse proxy's client-IP headers so rate limiting can tell one
# visitor from another. Production runs gunicorn behind nginx, which sets
# X-Real-IP and X-Forwarded-For (nginx/tarmar.conf), and there REMOTE_ADDR is
# nginx itself for everyone — one shared bucket, so ten wrong passphrases from
# anybody locked out the whole site. Set this to true ONLY where every request
# arrives through that proxy: on a directly reachable port the headers are
# whatever the caller typed, and trusting them lets an attacker mint a fresh
# identity per request and walk past the limits entirely. Leave it unset (off)
# for local development, where runserver is the edge.
# TRUST_PROXY_IP_HEADER=true

# Which socket peers are allowed to set those headers, comma-separated. The
# flag above describes the deployment; this describes the connection, and both
# have to agree before a header is believed. Defaults to loopback
# (127.0.0.1,::1), which is where nginx proxies from — set it only if the proxy
# moves to another host. Note the residual gap this alone cannot close:
# gunicorn binds loopback on a box that also hosts melee and orge, so a
# process on that same box still clears this check by itself — see
# PROXY_SHARED_SECRET below for what closes it.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# A secret only nginx is meant to know, sent as a header on every proxied
# request, closing the gap TRUSTED_PROXY_IPS leaves open above: nginx and any
# other process on this box present the identical loopback peer address, so
# the peer check alone can't tell them apart. The value must match what
# nginx/tarmar.conf sends — see nginx/tarmar-proxy-secret.conf.example for
# the nginx-side half. Leave unset for local development, and anywhere nginx
# hasn't been given that file yet: the app simply falls back to the
# peer-IP-only check, exactly today's behaviour (issue #161 part 3).
# PROXY_SHARED_SECRET=

# Mail (issues #929, #931). Password reset and email-address confirmation
# are the only things that send mail.
# Production hands it to the host's own postfix on localhost:25: no login, no
# TLS, which is what every default below already is, so the host needs only
# DEFAULT_FROM_EMAIL. Settings refuse to start without it when DEBUG=False. It
# must be a sender postfix accepts, and it is the address the receiving server
# judges the message by. A bare address only: deploy.sh refuses spaces and
# quotes, so no "Name <address>" form. See DEPLOY.md, Mail.
# DEFAULT_FROM_EMAIL=tarmar@roots.origamisoftware.com
#
# Unset, the backend is the console under DEBUG (messages print in runserver's
# output) and SMTP otherwise. Set it to override either; the browser tests use
# django.core.mail.backends.filebased.EmailBackend with EMAIL_FILE_PATH.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_FILE_PATH=/tmp/tarmar-mail
#
# Only for a relay other than the local postfix. Defaults: localhost, 25,
# empty user and password, TLS off.
# EMAIL_HOST=localhost
# EMAIL_PORT=25
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=false
#
# The scheme and host every password-reset link is built on (and every
# email-confirmation link, #931): the emailed one
# (instead of the request's Host header) and the one `manage.py
# password_reset_link <username>` prints without --base-url. Unset, the email
# follows the request, and the command uses https://<first ALLOWED_HOSTS
# entry>, or http://127.0.0.1:8000 under DEBUG.
# SITE_BASE_URL=https://tarmar.origamisoftware.com

# The footer's source links (#914, #997). The one public repository holds the
# code, its history and the deployed commits, and is where issues are filed:
# "Source code" links to its root and "Leave a comment" to its issue forms; the
# footer's Version links to the running commit there for a Game Master or
# admin only. This is the default.
# REPOSITORY_PUBLIC_URL=https://github.com/smarks/tarmar-studio

# Ollama (LLM runtime)
OLLAMA_BASE_URL=http://localhost:11434

# GM model — web GM and CLI alike; defaults live in gm/model_config.py.
# The model must be pulled in Ollama first: `ollama pull qwen3.6:27b-mlx`.
# GM_MODEL=qwen3.6:27b-mlx
# GM_NUM_CTX=65536
# GM_TEMPERATURE=0.8

# What a player reads while their turn waits behind other tables' turns for the
# model, and when a turn or a fight runs out of time (issue #64). Each is a
# str.format template: defaults and the fields each may use ({seconds},
# {turns_ahead}, {waited_seconds}, {budget_seconds}) are in settings.py, a
# literal brace is written doubled, and a template that cannot be filled in
# refuses to start. An uncommented empty value means the default.
# GM_QUEUE_STATUS_ONE_AHEAD=
# GM_QUEUE_STATUS_MANY_AHEAD=
# GM_STREAM_TOO_SLOW_MESSAGE=
# GM_STREAM_QUEUED_TOO_LONG_MESSAGE=
# GM_FIGHT_TOO_SLOW_MESSAGE=
# What the Battle tab says when a fight is answered with an error page rather
# than the app's JSON (#94): nginx's own 504, or another status ({status}). The
# page fills these in itself, so each field must be a bare {name}.
# GM_FIGHT_GATEWAY_TIMEOUT_MESSAGE=
# GM_FIGHT_ERROR_PAGE_MESSAGE=

# The Tarmar canon (issue #921): the DM-only pages served under
# /reference/dm-rules/, the map manifest and the GM's world prompt. It lives in
# the private repository smarks/tarmar-canon, whose root is the canon
# directory; clone it and point this at the clone. Must be the absolute path of
# an existing directory. Unset, the app runs on the generic default canon in
# reference/default_canon, which is how a public checkout runs. It must be a
# real environment variable: settings.py imports reference.paths, which reads
# it, before load_dotenv runs, so for local development export it in your
# shell; a value set only in this file is ignored there. Production sets it
# here and systemd's EnvironmentFile hands it to the units; deploy.sh refuses
# to deploy unless it names the checkout the deploy keeps current, which is
# the documented production value below (DEPLOY.md).
# TARMAR_CANON_DIR=/home/sam/dev/tarmar-canon

# Rules markdown the GM loads into its prompt
# (defaults to <BASE_DIR>/reference/content/public-rules)
# RULES_DIR=/path/to/rules

# Browser tests only (issue #959): lets a request pin its own dice with an
# X-E2E-Dice-Seed header. playwright.config.js sets it for the dev server it
# starts; settings.py refuses to load with it unless DEBUG=true. Never set it
# anywhere else.
# E2E_DICE_SEEDING=true
