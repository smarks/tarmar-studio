  "rulings": [
    {
      "key": "attribute_modifier_clamps_to_the_table",
      "reading": "attributes.md's modifier table prints scores 3 to 18 and nothing past either end, though a score can leave that range (a Laborer's +1 STR, DEX or CON, a Game Master's figure, aging). Ruled: a score below 3 takes the -5 of the lowest row and a score above 18 the +5 of the highest, rather than the slope continuing (issue #806). The page prints this as a provisional house ruling.",
      "page": "public-rules/characters/attributes.md",
      "for_spencer": true
    },
    {
      "key": "focused_knowledge_field_bonus",
      "reading": "The skills glossary lets the GM allow a focused Knowledge field 'for a larger bonus in it' without a number. Ruled: a focused field adds +1 to checks in that field, on top of the skill's level (focused_field_bonus 1; issue #808). The page prints this as a provisional house ruling.",
      "page": "public-rules/characters/prior-experience/skills-glossary.md",
      "for_spencer": true
    },
    {
      "key": "arcane_checked_on_intelligence",
      "reading": "The skills glossary prices Arcane (True Magic) and channel.md uses it, but no glossary table gives it a Governs entry. Ruled: Arcane rides on INT, which attributes.md says governs perceiving, retaining and applying knowledge, the study True Magic is (implied_governing_attributes).",
      "page": "public-rules/characters/prior-experience/skills-glossary.md",
      "for_spencer": true
    },
    {
      "key": "attribute_check_modifier_limit",
      "reading": "An attribute check is 3d6 at or under the attribute, and the pages set no bound on a situational modifier a GM puts on the target. Ruled: at most 10 either way (game_master_modifier_limit 10; issue #953). The limit is a ruling, not where the dice settle the check: at +10 a score of 8 or more cannot fail, but a score of 3 needs +15 before the result is certain. A GM who means a result to be certain rules it rather than rolls it.",
      "page": "public-rules/combat/action-options/attack-rolls.md",
      "for_spencer": true
    }
  ]
}
