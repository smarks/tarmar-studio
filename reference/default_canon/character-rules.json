  "rulings": [
    {
      "key": "height_chain_counts_every_one_and_six",
      "reading": "attributes.md's height table says to roll again on a 1 and subtract 4 inches each time, and to roll again on a 6 and add 4 inches each time, so it describes a chain that starts with a 1 or a 6. Ruled: after the first face, every further 1 takes 4 inches off and every further 6 adds 4, whatever the first face was, so 6.1.3 gives 72 inches and 1.6.3 gives 60.",
      "page": "public-rules/characters/attributes.md",
      "for_spencer": true
    },
    {
      "key": "village_grants_street_smarts_first",
      "reading": "location.md gives a Village origin 'Street smarts OR survival (choose)'. The location is rolled after the creation form is sent, so the grant goes to the first listed skill, Street Smarts, and the player moves it to Survival on the sheet (issue #754).",
      "page": "public-rules/characters/location.md",
      "for_spencer": true
    },
    {
      "key": "height_floor",
      "reading": "attributes.md takes 4 inches off for each further 1 on the height die and states no floor. Ruled: a height never goes below 24 inches (minimum_inches), so a long chain of 1s, or an edited one, cannot give a negative or absurd height.",
      "page": "public-rules/characters/attributes.md",
      "for_spencer": true
    },
    {
      "key": "strength_halved_rounds_down",
      "reading": "attributes.md adds STR ÷ 2 stones to the base weight without saying how a half is rounded. Ruled: rounded down (strength_divisor 2, whole stones).",
      "page": "public-rules/characters/attributes.md",
      "for_spencer": true
    }
  ]
}
